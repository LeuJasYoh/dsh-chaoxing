{
  "name": "dsh-xuexi-next",
  "version": "0.1.0",
  "description": "DSH 网课模式重写版：先把手和眼还给模型，再做可选的业务流程",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "prompts",
    "tools",
    "lib",
    "docs",
    "locale/*.json",
    "icon.svg",
    "scripts"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/cxsecret.test.mjs && node test/tasks.test.mjs && node test/scroll.test.mjs && node test/questions.test.mjs && node test/observe.test.mjs",
    "test:live": "node test/live-questions.mjs",
    "test:live:plain": "node test/live-plain.mjs",
    "test:live:tasks": "node test/live-tasks.mjs",
    "test:live:scroll": "node test/live-scroll.mjs",
    "test:live:tools": "node test/live-tools.mjs",
    "test:static": "node test/live-static-observe.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-preset",
    "browser-automation",
    "cdp"
  ],
  "dsh": {
    "id": "dsh-xuexi-next",
    "name": "网课模式（重写）",
    "version": "0.1.0",
    "engines": {
      "dsh": ">=0.2.0"
    },
    "permissions": "注册 Agent 预设, 系统提示词注入, 工具注册",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
